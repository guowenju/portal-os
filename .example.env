# PortalOS alpha.2 本地开发环境变量示例。
# 使用前复制为 .env，并务必在公开部署时替换示例密码。

# Rust 日志过滤级别。
RUST_LOG=info

# SQLite 数据目录；后端会在其中创建 portal-os.sqlite3。
PORTAL_OS_DATA_DIR=./data

# 空数据库首次启动时创建的唯一管理员账号。
PORTAL_OS_ADMIN_USERNAME=admin

# 管理员初始密码，至少 12 个字符；公开部署禁止使用此示例值。
PORTAL_OS_ADMIN_PASSWORD=portal-os-dev-password

# 可选：前后端分离部署时允许的来源，多个地址使用英文逗号分隔。
# PORTAL_OS_ALLOWED_ORIGINS=https://blog.example.com
